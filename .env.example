# Server-only Supabase credentials. Only the anon key is passed to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Exact comma-separated admin email allowlist; no public signup UI is provided.
ADMIN_EMAILS=you@example.com
# Generate independently with: openssl rand -hex 32
NODE_REGISTRATION_SECRET=
WORKER_INFERENCE_KEY=
# Optional: fallback order is Groq -> OpenRouter -> Hugging Face.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
